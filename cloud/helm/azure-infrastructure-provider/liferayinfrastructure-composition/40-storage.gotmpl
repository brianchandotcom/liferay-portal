{{- $storage := $xr.spec.storage | default dict -}}

{{- range $i, $dataPlane := $dataPlanes }}
{{- $storageAccountName := index $storageAccountNames $dataPlane }}
{{- if $i }}
---
{{- end }}
apiVersion: storage.azure.m.upbound.io/v1beta1
kind: Account
metadata:
    annotations:
        gotemplating.fn.crossplane.io/composition-resource-name: liferay-storage-account-{{ $dataPlane }}
    labels:
        dataPlane: {{ $dataPlane }}
        dataPlaneKey: {{ index $dataPlaneKeys $dataPlane }}
    name: {{ $storageAccountName }}
spec:
    forProvider:
        accountReplicationType: LRS
        accountTier: Standard
        allowNestedItemsToBePublic: false
        blobProperties:
            changeFeedEnabled: true
            containerDeleteRetentionPolicy:
                days: 7
            deleteRetentionPolicy:
                days: 7
            versioningEnabled: {{ hasKey $storage "enableVersioning" | ternary $storage.enableVersioning true }}
        {{- if $cmkEnabled }}
        customerManagedKey:
            keyVaultKeyId: {{ $cmkKeyVaultKeyId }}
            userAssignedIdentityId: {{ $cmkIdentityId }}
        identity:
            identityIds:
                -   {{ $cmkIdentityId }}
            type: UserAssigned
        {{- end }}
        location: {{ $region }}
        resourceGroupName: {{ $env.resourceGroupName }}
        sharedAccessKeyEnabled: true
        tags:
            {{- with $storage.tags }}
            {{- . | toYaml | nindent 12 }}
            {{- end }}
            active: {{ printf "%t" (eq $dataPlane $activeDataPlane) | quote }}
            data-plane: {{ $dataPlane }}
            should-back-up: "true"
    managementPolicies: {{ $managementPolicies }}
    writeConnectionSecretToRef:
        name: liferay-storage-{{ $dataPlane }}-credentials
{{- if or (eq $dataPlane $activeDataPlane) (eq $restorePhase "promoting") }}
---
apiVersion: storage.azure.m.upbound.io/v1beta1
kind: Container
metadata:
    annotations:
        crossplane.io/external-name: document-library
        gotemplating.fn.crossplane.io/composition-resource-name: liferay-storage-container-{{ $dataPlane }}
    labels:
        dataPlane: {{ $dataPlane }}
    name: {{ $storageAccountName }}-document-library
spec:
    forProvider:
        storageAccountIdSelector:
            matchControllerRef: true
            matchLabels:
                dataPlane: {{ $dataPlane }}
    managementPolicies: {{ $managementPolicies }}
{{- end }}
{{- end }}