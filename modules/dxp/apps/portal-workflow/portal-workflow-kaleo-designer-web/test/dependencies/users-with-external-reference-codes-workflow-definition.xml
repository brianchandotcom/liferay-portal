<?xml version="1.0"?>

<workflow-definition
	xmlns="urn:liferay.com:liferay-workflow_7.4.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="urn:liferay.com:liferay-workflow_7.4.0 http://www.liferay.com/dtd/liferay-workflow-definition_7_4_0.xsd"
>
	<name>Users with External Reference Codes</name>
	<state>
		<name>Start</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						100
					]
				}
			]]>
		</metadata>
		<initial>true</initial>
		<transitions>
			<transition>
				<name>review</name>
				<target>Review</target>
				<default>true</default>
			</transition>
		</transitions>
	</state>
	<task>
		<name>Review</name>
		<metadata>
			<![CDATA[
				{
					"xy": [
						300,
						260
					]
				}
			]]>
		</metadata>
		<actions>
			<notification>
				<name>Review Notification</name>
				<template>A new submission is waiting for your review.</template>
				<template-language>text</template-language>
				<notification-type>email</notification-type>
				<recipients>
					<user>
						<user-external-reference-code>USER2_ERC</user-external-reference-code>
						<user-id>2</user-id>
					</user>
				</recipients>
				<execution-type>onEntry</execution-type>
			</notification>
		</actions>
		<assignments>
			<user>
				<user-external-reference-code>USER1_ERC</user-external-reference-code>
				<user-id>1</user-id>
			</user>
		</assignments>
		<task-timers>
			<task-timer>
				<name>Timer</name>
				<delay>
					<duration>1</duration>
					<scale>day</scale>
				</delay>
				<blocking>true</blocking>
				<timer-actions>
					<timer-notification>
						<name>Timer Notification</name>
						<template>The submission is still waiting for your review.</template>
						<template-language>text</template-language>
						<notification-type>email</notification-type>
						<recipients>
							<user>
								<user-external-reference-code>USER4_ERC</user-external-reference-code>
								<user-id>4</user-id>
							</user>
						</recipients>
					</timer-notification>
					<reassignments>
						<user>
							<user-external-reference-code>USER3_ERC</user-external-reference-code>
							<user-id>3</user-id>
						</user>
					</reassignments>
				</timer-actions>
			</task-timer>
		</task-timers>
		<transitions>
			<transition>
				<name>end</name>
				<target>End</target>
				<default>true</default>
			</transition>
		</transitions>
	</task>
	<state>
		<name>End</name>
		<metadata>
			<![CDATA[
				{
					"terminal": true,
					"xy": [
						300,
						500
					]
				}
			]]>
		</metadata>
	</state>
</workflow-definition>