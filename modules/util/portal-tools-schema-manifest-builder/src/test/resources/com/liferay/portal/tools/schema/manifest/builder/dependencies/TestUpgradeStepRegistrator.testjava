package com.liferay.test.internal.upgrade.registry;

import com.liferay.portal.configuration.upgrade.ConfigurationUpgradeStepFactory;
import com.liferay.portal.kernel.upgrade.BaseUuidUpgradeProcess;
import com.liferay.portal.kernel.upgrade.DummyUpgradeStep;
import com.liferay.portal.kernel.upgrade.UpgradeProcessFactory;
import com.liferay.portal.kernel.upgrade.UpgradeStep;
import com.liferay.portal.upgrade.registry.UpgradeStepRegistrator;
import com.liferay.test.internal.upgrade.v1_0_0.util.TestTable;

public class TestUpgradeStepRegistrator
	implements UpgradeStepRegistrator {

	@Override
	public void register(Registry registry) {
		registry.registerInitialization();

		registry.registerReleaseCreationUpgradeSteps(
			new DummyUpgradeStep());

		registry.register("0.0.1", "1.0.0", new DummyUpgradeStep());

		registry.register(
			"1.0.0", "1.0.0.step-1",
			UpgradeProcessFactory.addColumns(
				"TestEntry", "name VARCHAR(75) null"),
			TestTable.create(),
			new com.liferay.test.internal.upgrade.
				v1_0_0.TestUpgradeProcess("a, (b"));

		registry.register(
			"1.0.0.step-1", "1.9.0",
			new BaseUuidUpgradeProcess() {

				@Override
				protected UpgradeStep[] getPreUpgradeSteps() {
					return new UpgradeStep[] {
						UpgradeProcessFactory.dropColumns("TestEntry", "x")
					};
				}

			},
			() -> {
			});

		UpgradeStep upgradeStep = new DummyUpgradeStep() {
		};

		registry.register(
			"1.9.0", "1.10.0", upgradeStep,
			(UpgradeStep)new DummyUpgradeStep(),
			_configurationUpgradeStepFactory.createUpgradeStep(
				"a", "b"));

		registry.register("1.10.0", "2.0.0");
	}

	private ConfigurationUpgradeStepFactory _configurationUpgradeStepFactory;

}