package com.liferay.source.formatter.dependencies;

/**
 * @author Alan Huang
 */
public class JavaNestedSwitchExpressions {

	public String getLabel(int type, int subtype) {
		return switch (type) {
			case 1 -> switch (
				subtype) {
					case 1 ->
						"first";
				default
					-> "other";
};
				default -> "other";
		};
	}

}