package com.liferay.source.formatter.dependencies;

import com.liferay.source.formatter.dependencies.shape.Line;
import com.liferay.source.formatter.dependencies.shape.Point;

/**
 * @author Alan Huang
 */
public class JavaRecordPatterns {

	public int getSum(Object object) {
		return switch (object) {
			case Point(
				int x, int y) -> x + y;
			case Line(Point(int x, int y),
				Point end) -> x + y + getSum(end);
			default -> 0;
		};
	}

	public int getTaxicabDistance(Object object) {
		if (object instanceof
				Point(int x, int y)) {

			return Math.abs(x) + Math.abs(y);
		}

		if (object instanceof Line(
				Point(var x1, var y1),
				Point(var x2, var y2))) {

			return Math.abs(x2 - x1) + Math.abs(y2 - y1);
		}

		return 0;
	}

}