package com.liferay.source.formatter.dependencies;

/**
 * @author Alan Huang
 */
public class PatternMatchingForSwitch {

	public String getLabel(Object object) {
		return switch (object) {
			case Integer integer when integer > 0 -> "positive";
			case String string -> string;
			default -> "other";
		};
	}

	public String getName(int type) {
		return switch (type) {
			case 1 -> "one";
			case 2 -> "two";
			default -> "other";
		};
	}

	public String getNestedLabel(int type, Object object) {
		switch (type) {
			case 1:
				return switch (object) {
					case String string -> string;
					default -> "other";
				};
			default:
				return "other";
		}
	}

}