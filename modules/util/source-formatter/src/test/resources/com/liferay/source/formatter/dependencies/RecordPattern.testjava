package com.liferay.source.formatter.dependencies;

import com.liferay.source.formatter.dependencies.shape.Line;
import com.liferay.source.formatter.dependencies.shape.Point;

/**
 * @author Alan Huang
 */
public class RecordPattern {

	public int getLength(Object object) {
		if (object instanceof
				Line(Point(var x1, var y1), Point(var x2, var y2))) {

			return Math.abs(x2 - x1) + Math.abs(y2 - y1);
		}

		return 0;
	}

	public int getStringLength(Object object) {
		if (object instanceof String string) {
			return string.length();
		}

		return 0;
	}

}